{
  "name": "dsh-tool-podcast",
  "version": "1.0.0",
  "description": "Podcast tooling for DeepSeek Harness: detect chapter boundaries from silence, cut a recording into segments, write an iTunes-compatible RSS feed, and normalise loudness. Shells out to a local ffmpeg.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "podcast",
    "podcasting",
    "ffmpeg",
    "rss",
    "itunes",
    "audio",
    "silence-detection",
    "loudness",
    "播客"
  ],
  "author": "yuehancn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuehancn/dsh-tool-podcast.git"
  },
  "homepage": "https://github.com/yuehancn/dsh-tool-podcast#readme",
  "bugs": {
    "url": "https://github.com/yuehancn/dsh-tool-podcast/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  }
}